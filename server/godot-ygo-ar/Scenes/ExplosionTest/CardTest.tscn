[gd_scene load_steps=5 format=3]

[ext_resource type="Texture2D" uid="uid://daivuetf3svw" path="res://Assets/Images/Cards/Monster/flame_swordsman.jpg" id="1_front"]
[ext_resource type="Texture2D" uid="uid://dgv8gejyha6e7" path="res://Assets/Images/Cards/card_back.jpg" id="2_back"]
[ext_resource type="Shader" uid="uid://dw5pjpsxckas0" path="res://Scenes/ExplosionTest/card_shader.gdshader" id="4_shader"]

[sub_resource type="GDScript" id="GDScript_card"]
script/source = "@tool
extends Node3D

signal exploded(speed)

@export_range(1, 200, 1) var num_divisions := 1
@export var FrontTexture: Texture2D:
	set = set_front
@export var shader: Shader

const BackTexture = preload(\"res://Assets/Images/Cards/card_back.jpg\")
const SHARD_SCENE = preload(\"res://Scenes/ExplosionTest/Shard.tscn\")

@onready var CardMesh: CSGPolygon3D = $CardMesh
@onready var Shards: Node3D = $Shards
@onready var Sprites: Node3D = $Sprites
@onready var FrontSprite: Sprite3D = $Sprites/Front
@onready var BackSprite: Sprite3D = $Sprites/Back
@onready var Position: Marker3D = $Position

var back_image: Image
var front_image: Image
var save_points := PackedVector2Array()

func set_front(texture: Texture2D) -> void:
	FrontTexture = texture
	if texture == null:
		front_image = null
		return
	if Engine.is_editor_hint() and is_inside_tree():
		$Sprites/Front.texture = texture
	front_image = _readable_image(texture.get_image())

func _ready() -> void:
	save_points = PackedVector2Array(CardMesh.polygon)
	BackSprite.texture = BackTexture
	FrontSprite.texture = FrontTexture
	back_image = _readable_image(BackTexture.get_image())
	if front_image == null and FrontTexture:
		front_image = _readable_image(FrontTexture.get_image())
	create_shards()

func reset() -> void:
	CardMesh.polygon = PackedVector2Array(save_points)
	create_shards()

func destroy() -> void:
	for shard in Shards.get_children():
		shard.queue_free()

func create_shards() -> void:
	if front_image == null or back_image == null or FrontTexture == null:
		return
	for shard in Shards.get_children():
		shard.queue_free()
	var points := PackedVector2Array(CardMesh.polygon)
	var offset := Vector2(absf(points[0].x), absf(points[0].y))
	var mesh_size := Vector2(points[6].x - points[0].x, points[2].y - points[0].y)
	var front_image_size := FrontTexture.get_size()
	var back_image_size := BackTexture.get_size()
	var max_x := points[6].x
	var max_y := points[2].y
	for i in range(num_divisions - 1):
		points.append(Vector2(randf_range(points[0].x, max_x), randf_range(points[0].y, max_y)))
	var delaunay_points := Geometry2D.triangulate_delaunay(points)
	for i in range(int(delaunay_points.size() / 3.0)):
		var shard_points := PackedVector2Array()
		for n in range(3):
			shard_points.append(points[delaunay_points[i * 3 + n]])
		var material := ShaderMaterial.new()
		material.shader = shader
		var shard = SHARD_SCENE.instantiate()
		var point_a := shard_points[0] + offset
		var point_b := shard_points[1] + offset
		var point_c := shard_points[2] + offset
		var center := (shard_points[0] + shard_points[1] + shard_points[2]) / 3.0
		var max_triangle_x := maxf(maxf(point_a.x, point_b.x), point_c.x)
		var max_triangle_y := maxf(maxf(point_a.y, point_b.y), point_c.y)
		var min_triangle_x := minf(minf(point_a.x, point_b.x), point_c.x)
		var min_triangle_y := minf(minf(point_a.y, point_b.y), point_c.y)
		var rel_start_x := maxf(min_triangle_x / mesh_size.x, 0.0)
		var rel_start_y := maxf(min_triangle_y / mesh_size.y, 0.0)
		var rel_end_x := maxf(max_triangle_x / mesh_size.x, 0.0)
		var rel_end_y := maxf(max_triangle_y / mesh_size.y, 0.0)
		var front_rect := _image_rect(front_image_size, rel_start_x, rel_start_y, rel_end_x, rel_end_y)
		var back_rect := _image_rect(back_image_size, rel_start_x, rel_start_y, rel_end_x, rel_end_y)
		if not front_rect.has_area() or not back_rect.has_area():
			continue
		var front_texture := ImageTexture.create_from_image(front_image.get_region(front_rect))
		var back_texture := ImageTexture.create_from_image(back_image.get_region(back_rect))
		material.set_shader_parameter(\"back_sprite\", back_texture)
		material.set_shader_parameter(\"front_sprite\", front_texture)
		Shards.add_child(shard)
		shard.material = material
		shard.polygon = shard_points
		shard.set_position_vec(Position.position + Vector3(center.x, center.y, 0))
		shard.init(self)
	Sprites.visible = false

func _image_rect(image_size: Vector2, rel_start_x: float, rel_start_y: float, rel_end_x: float, rel_end_y: float) -> Rect2:
	var image_x := rel_start_x * image_size.x
	var image_y := rel_start_y * image_size.y
	var image_end_x := rel_end_x * image_size.x
	var image_end_y := rel_end_y * image_size.y
	var image_width := image_end_x - image_x
	var image_height := image_end_y - image_y
	return Rect2(int(absf(image_x)), int(absf(image_size.y - image_y - image_height)), int(absf(image_width)), int(absf(image_height)))

func _readable_image(image: Image) -> Image:
	if image != null and image.is_compressed():
		image.decompress()
	return image

func explode() -> void:
	exploded.emit(25.0)
"

