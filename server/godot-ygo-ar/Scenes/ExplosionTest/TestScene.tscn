[sub_resource type="GDScript" id="GDScript_root"]
script/source = "extends Node3D

@onready var cards = $Cards

func _input(event):
	if event.is_echo():
		return
	if Input.is_action_just_pressed(\"ui_accept\"):
		for card in cards.get_children():
			card.explode()
		$AudioStreamPlayer.play()
	elif Input.is_action_just_pressed(\"ui_left\"):
		for card in cards.get_children():
			card.destroy()
	elif Input.is_action_just_pressed(\"ui_right\"):
		for card in cards.get_children():
			card.reset()
		$AudioStreamPlayer.stop()
"

[sub_resource type="GDScript" id="GDScript_camera"]
script/source = "extends Camera3D

const DEBUG_MOUSE_SENSETIVITY = 0.2
const DEBUG_MOVEMENT_SPEED = 0.2

func _ready():
	Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)

func _input(event):
	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		var movement = event.relative
		rotation.x += -deg_to_rad(movement.y * DEBUG_MOUSE_SENSETIVITY)
		rotation.y += -deg_to_rad(movement.x * DEBUG_MOUSE_SENSETIVITY)

func _process(_delta):
	var cam_xform := global_transform
	var input_axis := Vector3()
	input_axis.y = float(int(Input.is_action_pressed(\"cam_down\")) - int(Input.is_action_pressed(\"cam_up\")))
	input_axis.x = float(int(Input.is_action_pressed(\"cam_right\")) - int(Input.is_action_pressed(\"cam_left\")))
	input_axis.z = float(int(Input.is_action_pressed(\"move_up\")))
	input_axis = input_axis.normalized()
	var move_axis := Vector3.ZERO
	move_axis += cam_xform.basis.z * input_axis.y
	move_axis += cam_xform.basis.x * input_axis.x
	move_axis.y += input_axis.z
	global_position += move_axis.normalized() * DEBUG_MOVEMENT_SPEED
	if Input.is_action_just_pressed(\"ui_cancel\"):
		if Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
			Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
		else:
			Input.set_mouse_mode(Input.MOUSE_MODE_CAPTURED)
"

