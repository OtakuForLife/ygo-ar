[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_shard"]
script/source = "extends CSGPolygon3D

var max_speed = 0.0
var direction = Vector3()
var rot_speed = 0.0
var speed_mul = randf()

@onready var timer = $Timer

func _process(delta):
	var velocity = direction.normalized() * max_speed * delta * speed_mul
	position += velocity
	rotation.z += rot_speed

func move(speed: float):
	max_speed = speed
	rot_speed = randf_range(-0.005, 0.005)
	timer.start()

func set_position_vec(vec: Vector3):
	direction = vec

func init(card):
	card.exploded.connect(move)

func _on_Timer_timeout():
	queue_free()
"

[node name="Shard" type="CSGPolygon3D"]
cast_shadow = 0
depth = 0.001
script = SubResource("GDScript_shard")

[node name="Timer" type="Timer" parent="."]
wait_time = 2.5
one_shot = true

[connection signal="timeout" from="Timer" to="." method="_on_Timer_timeout"]
